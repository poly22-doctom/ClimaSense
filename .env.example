# Copie para ".env" e ajuste. NUNCA versione o arquivo .env.
APP_ENV=development

# SQLite (padrão). Para MySQL: mysql+pymysql://usuario:senha@host:3306/clima?charset=utf8mb4
DATABASE_URL=sqlite:///./weather.db

# Identificação da estação (a localização é apenas um texto configurável)
STATION_ID=estacao_01
STATION_NAME=Estação Meteorológica e Ambiental
STATION_LOCATION=Localização não configurada
TIMEZONE=America/Sao_Paulo

# Chaves (gere com: python -c "import secrets; print(secrets.token_urlsafe(32))")
# STATION_API_KEY: usada pelo ESP32 no cabeçalho X-API-Key para enviar leituras.
# ADMIN_API_KEY: usada para alterar os limites de alerta.
# Se ficarem vazias, os endpoints de escrita respondem 503 (ficam desativados).
STATION_API_KEY=
ADMIN_API_KEY=

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Modo de demonstração (dados SIMULADOS, sempre identificados como tal)
DEMO_MODE=true
SIMULATION_INTERVAL_SECONDS=300
SIMULATION_BACKFILL_DAYS=30

# Intervalo de atualização do painel (segundos)
REFRESH_SECONDS=30
